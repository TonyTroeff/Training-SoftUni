# Copy to `.env` and fill in. `.env` is gitignored; this file is not.
# Every setting is read exactly once, at startup, by assistant.config.load_config().

# --- Model -----------------------------------------------------------------
ASSISTANT_MODEL_NAME=claude-opus-4-8
ASSISTANT_API_BASE_URL=https://api.anthropic.com/v1
ASSISTANT_API_KEY=

# --- Request behaviour -----------------------------------------------------
ASSISTANT_REQUEST_TIMEOUT_S=60
ASSISTANT_MAX_HISTORY_MESSAGES=40

# Optional: path to a file whose contents become the system prompt.
# Startup fails loudly if the path is set but missing.
ASSISTANT_SYSTEM_PROMPT_PATH=prompts/system_prompt.md

# Force the scripted stand-in client even when an API key is present.
# Without a key the app falls back to it automatically.
ASSISTANT_USE_FAKE_CLIENT=false

# --- Storage ---------------------------------------------------------------
# Directory holding every hierarchy and entry. Relative paths resolve against
# the working directory; the directory is created at startup if missing.
ASSISTANT_DATA_DIR=./data

# --- Window ----------------------------------------------------------------
ASSISTANT_WINDOW_TITLE=Personal Assistant
ASSISTANT_WINDOW_WIDTH=920
ASSISTANT_WINDOW_HEIGHT=760
