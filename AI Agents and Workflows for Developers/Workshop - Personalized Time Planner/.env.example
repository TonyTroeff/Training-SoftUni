# Model used by the Main node and the three worker agents.
OPENAI_API_KEY=sk-...
TIME_PLANNER_MODEL=gpt-4.1-mini

# LangSmith. Set the API key to turn tracing on; leave it out to stay local.
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=personalized-time-planner

# Where long-term memory and checkpoints live (default: ./.time_planner).
# TIME_PLANNER_DATA_DIR=.time_planner
